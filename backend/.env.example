# Copy to backend/.env. Never commit .env or put backend secrets in the frontend.
# Process environment overrides this file. Restart Django after changing settings.

# Local development only; a private key is required with DJANGO_DEBUG=false.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Paths are absolute or relative to backend/, never the shell's working directory.
# Create custom parent directories before running migrate/collectstatic.
SQLITE_PATH=db.sqlite3
MEDIA_ROOT=media
STATIC_ROOT=staticfiles

# Future generated audio URLs use this base. localhost is browser-local only;
# a configured speaker needs a LAN-reachable host also in DJANGO_ALLOWED_HOSTS.
BACKEND_PUBLIC_BASE_URL=http://localhost:8000

# Fixed synthetic patient used by seed_demo and future legacy AAC routes.
# This is never a mutable "currently selected patient" setting.
LEGACY_DEMO_PATIENT_ID=22222222-2222-4222-8222-222222222222

# Text-to-speech. SPEECH_PROVIDER picks a provider in aac/speech.py (currently
# elevenlabs). Voice/model IDs are provider-specific; a patient's
# preferences.voice_id overrides SPEECH_VOICE_ID. Blank model = provider default
# (eleven_flash_v2_5). Missing key or voice makes speech return 503.
SPEECH_PROVIDER=elevenlabs
SPEECH_VOICE_ID=
SPEECH_MODEL_ID=
# Reuse audio for identical provider/model/voice/text; run cleanup_audio to bound disk.
SPEECH_CACHE=true
ELEVENLABS_API_KEY=

# On-device speech-to-text for caregiver listen mode. TRANSCRIBE_PROVIDER picks a
# loader in aac/transcription.py (currently moonshine); blank disables it. Run
# `python manage.py fetch_transcription_model` once to download the model into
# TRANSCRIBE_MODEL_DIR. One thread measured about a third of one core on the UNO Q.
# TRANSCRIBE_DEVICE is the model runtime's device; only cpu works on the UNO Q today.
TRANSCRIBE_PROVIDER=
TRANSCRIBE_MODEL_DIR=models/moonshine-tiny-en
# On the UNO Q, 2 threads decoded a short question in 0.31 s instead of 0.46 s
# (RTF 0.21 vs 0.30); 3 threads was no faster.
TRANSCRIBE_THREADS=2
TRANSCRIBE_DEVICE=cpu
# On-device sentence embeddings for conversation suggestions (aac/embeddings.py).
# EMBED_PROVIDER=minilm uses sentence-transformers/all-MiniLM-L6-v2's int8 ARM build:
# copy onnx/model_qint8_arm64.onnx and tokenizer.json into EMBED_MODEL_DIR (keeping
# the onnx/ folder). Blank uses word-bank keywords instead. On the UNO Q one thread
# measured about 30 ms per question and 155 MiB next to Moonshine.
EMBED_PROVIDER=
EMBED_MODEL_DIR=models/minilm-l6-v2
EMBED_THREADS=1
# Listen mode (WS /ws/conversation/) records with arecord from this ALSA device:
# default, or plughw:<card>,0 for a USB microphone (find the card with arecord -l).
# file:<path> plays an audio file in real time instead, for demos without a mic.
# fetch_transcription_model also downloads the voice detector to LISTEN_VAD_MODEL.
LISTEN_DEVICE=default
LISTEN_VAD_MODEL=models/silero_vad.onnx
# Silence (0.2-1.0 s) that ends a phrase. Lower shows text sooner but may split a
# sentence where the speaker pauses; text arrives this long after speech stops, plus decoding.
LISTEN_SILENCE_SECONDS=0.5

# Optional Google Home IP; blank disables casting. Requires a LAN-reachable
# BACKEND_PUBLIC_BASE_URL (startup fails if it is localhost) also listed in
# DJANGO_ALLOWED_HOSTS. Set the frontend not to play locally when casting.
GOOGLE_HOME_HOST=

# AI phrase predictions. PREDICT_PROVIDER picks a provider in aac/llm.py:
# openai, anthropic, gemini or bedrock. Blank disables AI (history/default
# predictions only). PREDICT_MODEL is the provider's model ID; use a fast one,
# since slower answers are dropped after PREDICT_TIMEOUT_SECONDS (default 2, max 10).
# Defaults: anthropic=claude-haiku-5-5, gemini=gemini-3.5-flash-lite.
# The provider sees only the activity and time of day; patient history, favorites
# and transcripts stay on the device.
PREDICT_PROVIDER=
PREDICT_MODEL=
PREDICT_TIMEOUT_SECONDS=2
# Set only the credentials for the provider you use; each SDK reads its own.
# openai: OPENAI_BASE_URL is optional, for OpenAI-compatible APIs
# (OpenRouter, Groq, xAI, Mistral, a local Ollama, ...).
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional local CONNECT proxy for the USB demo when UNO Q cannot reach Google.
# Run hardware/gemini_proxy.py and adb reverse tcp:8767 tcp:8767 first.
# Leave blank when the backend has a working direct HTTPS connection.
GEMINI_PROXY_URL=
# bedrock: standard AWS credentials (aws login / AWS_PROFILE / access keys) and a
# region with model access. PREDICT_MODEL is a Bedrock model or inference profile ID.
AWS_PROFILE=
AWS_REGION=

# Exact browser origins for CORS and both WebSockets. Add the UNO Q LAN origin
# when opening the app from another computer (include the frontend port).
DJANGO_ALLOWED_ORIGINS=http://localhost:5173

# Blank = in-process inference for local development. Compose supplies this path;
# do not set it in the inference service itself. No TCP/hosted inference endpoint.
INFERENCE_SOCKET=
