# Copy to backend/.env. Never commit .env or put backend secrets in the frontend.
# Process environment overrides this file. Restart Django after changing settings.

# Local development only; a private key is required with DJANGO_DEBUG=false.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Paths are absolute or relative to backend/, never the shell's working directory.
# Create custom parent directories before running migrate/collectstatic.
SQLITE_PATH=db.sqlite3
MEDIA_ROOT=media
STATIC_ROOT=staticfiles

# Future generated audio URLs use this base. localhost is browser-local only;
# a configured speaker needs a LAN-reachable host also in DJANGO_ALLOWED_HOSTS.
BACKEND_PUBLIC_BASE_URL=http://localhost:8000

# Fixed synthetic patient used by seed_demo and future legacy AAC routes.
# This is never a mutable "currently selected patient" setting.
LEGACY_DEMO_PATIENT_ID=22222222-2222-4222-8222-222222222222

# Text-to-speech. SPEECH_PROVIDER picks a provider in aac/speech.py (currently
# elevenlabs). Voice/model IDs are provider-specific; a patient's
# preferences.voice_id overrides SPEECH_VOICE_ID. Blank model = provider default
# (eleven_flash_v2_5). Missing key or voice makes speech return 503.
SPEECH_PROVIDER=elevenlabs
SPEECH_VOICE_ID=
SPEECH_MODEL_ID=
# Reuse audio for identical provider/model/voice/text; run cleanup_audio to bound disk.
SPEECH_CACHE=true
ELEVENLABS_API_KEY=

# Optional Google Home IP; blank disables casting. Requires a LAN-reachable
# BACKEND_PUBLIC_BASE_URL (startup fails if it is localhost) also listed in
# DJANGO_ALLOWED_HOSTS. Set the frontend not to play locally when casting.
GOOGLE_HOME_HOST=

# AI phrase predictions. PREDICT_PROVIDER picks a provider in aac/llm.py:
# openai, anthropic, gemini or bedrock. Blank disables AI (history/default
# predictions only). PREDICT_MODEL is the provider's model ID; use a fast one,
# since slower answers are dropped after PREDICT_TIMEOUT_SECONDS (default 2, max 10).
# Blank model is only allowed for anthropic (claude-haiku-5-5).
PREDICT_PROVIDER=
PREDICT_MODEL=
PREDICT_TIMEOUT_SECONDS=2
# Set only the credentials for the provider you use; each SDK reads its own.
# openai: OPENAI_BASE_URL is optional, for OpenAI-compatible APIs
# (OpenRouter, Groq, xAI, Mistral, a local Ollama, ...).
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# bedrock: standard AWS credentials (aws login / AWS_PROFILE / access keys) and a
# region with model access. PREDICT_MODEL is a Bedrock model or inference profile ID.
AWS_PROFILE=
AWS_REGION=

# CORS currently allows only http://localhost:5173, for /api/ routes.
