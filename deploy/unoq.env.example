# Deployment settings only; all credentials stay in backend/.env.
AAC_PLATFORM=linux/arm64
AAC_IMAGE_TAG=local
AAC_BIND_ADDRESS=127.0.0.1
AAC_FRONTEND_PORT=5173
AAC_BACKEND_PORT=8000
# Confirm using arecord -l on the board. USB microphones may use another card.
AAC_LISTEN_DEVICE=plughw:0,0
# stat -c %g /dev/snd/pcmC0D0c (29 on the checked UNO Q)
AAC_AUDIO_GID=29
# Set blank to use keyword topic matching instead of MiniLM.
AAC_EMBED_PROVIDER=minilm
